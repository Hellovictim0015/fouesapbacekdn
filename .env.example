# Copy to .env.local (never commit .env.local). Next.js and the npm scripts read it automatically.

# MySQL 8. Without it the API runs in memory (development only; the admin panel needs it).
DATABASE_URL=mysql://root:password@127.0.0.1:3306/foues

# Signs login codes. 32+ random characters. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Signs the admin-panel cookie. 32+ random characters.
ADMIN_SESSION_SECRET=

# How login codes are delivered: console (prints in this server's log, development only), fast2sms (SMS) or fast2sms_whatsapp (WhatsApp template).
SMS_PROVIDER=console
# Fast2SMS key (https://www.fast2sms.com/dashboard/dev-api). Only when SMS_PROVIDER=fast2sms.
FAST2SMS_API_KEY=
# WhatsApp template id from Fast2SMS (only for SMS_PROVIDER=fast2sms_whatsapp).
FAST2SMS_WA_MESSAGE_ID=38384
# Development only: every login code becomes this value, so the emulator needs no SMS.
OTP_DEV_CODE=123456

# Requests per minute per signed-in user.
RATE_LIMIT_PER_MIN=120

# Shown on the public privacy, terms and delete-account pages. Required before release.
CONTACT_EMAIL=

# Payments use Razorpay. The keys are normally typed in Admin > Payments (stored encrypted, never shown again).
# These three are only a first-time fallback; keys saved in the admin panel win.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Development only (refused in production): pretend payments, no Razorpay account needed.
# PAY_MODE=fake
